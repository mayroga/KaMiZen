        },
        {
          "t":"d",
          "q":{"en":"What is the best thought?"},
          "op":[
            "I will fail",
            "I cannot do it",
            "I go step by step",
            "I give up"
          ],
          "c":2,
          "ex":[
            "Failure = fear",
            "Cannot = block",
            "Step by step = control",
            "Giving up = stop"
          ]
        },
        {
          "t":"d",
          "q":{"en":"What builds self-trust?"},
          "op":[
            "Attacking yourself mentally",
            "Encouraging yourself calmly",
            "Quitting early",
            "Comparing yourself constantly"
          ],
          "c":1,
          "ex":[
            "Self-attacks increase fear.",
            "Correct. Calm support builds confidence.",
            "Quitting weakens trust.",
            "Comparison increases insecurity."
          ]
        },
        {"t":"r","tx":"+Self Trust","p":30},
        {
          "t":"sil",
          "d":60,
          "tx":{"en":"Say: I am ready"},
          "inf":{"en":"Builds confidence"}
        },
        {
          "t":"breath_auto",
          "d":30,
          "tx":{"en":"Inhale strength... exhale fear"},
          "inf":{"en":"Helps emotional control"}
        }
      ]
    },
