        {
          "t":"breath_auto",
          "d":35,
          "tx":{"en":"Slow breath to help your memory"},
          "inf":{"en":"Helps your brain remember better"}
        },
        {
          "t":"d",
          "q":{"en":"What should you do if a question is hard?"},
          "op":[
            "Freezing stops thinking",
            "Skip and return later",
            "Give up",
            "Panic"
          ],
          "c":1,
          "ex":[
            "Freezing stops thinking",
            "Skipping helps strategy",
            "Giving up ends progress",
            "Panic blocks memory"
          ]
        },
        {
          "t":"d",
          "q":{"en":"What helps solve difficult problems?"},
          "op":[
            "Panicking immediately",
            "Breaking it into steps",
            "Thinking you are incapable",
            "Stopping completely"
          ],
          "c":1,
          "ex":[
            "Panic reduces clear thinking.",
            "Correct. Small steps improve problem solving.",
            "Negative beliefs block effort.",
            "Stopping removes all progress."
          ]
        },
        {"t":"r","tx":"+Smart Thinking","p":25},
        {
          "t":"sil",
          "d":50,
          "tx":{"en":"Break it into small steps"},
          "inf":{"en":"Helps your brain solve problems"}
        },
        {
          "t":"breath_auto",
          "d":30,
          "tx":{"en":"Inhale clarity... exhale doubt"},
          "inf":{"en":"Helps thinking become clear"}
        }
      ]
    },
    {
      "id":40,
      "cat":"self_support",
      "b":[
        {"t":"v","tx":{"en":"MISSION 40: YOU CAN SUPPORT YOURSELF"}},
        {"t":"h","tx":{"en":"You are not alone inside your mind"}},
