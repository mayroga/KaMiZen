            "Quit studying"
          ],
          "c":1,
          "ex":[
            "Worry = stress continues",
            "Accept = peace",
            "Blame = sadness",
            "Quit = stop growth"
          ]
        },
        {
          "t":"d",
          "q":{"en":"What helps recovery after stress?"},
          "op":[
            "Overthinking constantly",
            "Attacking yourself mentally",
            "Resting calmly",
            "Refusing to relax"
          ],
          "c":2,
          "ex":[
            "Overthinking extends stress.",
            "Self-criticism increases emotional pain.",
            "Correct. Rest helps recovery.",
            "No rest delays recovery."
          ]
        },
        {"t":"r","tx":"+Peace","p":35},
        {
          "t":"sil",
          "d":80,
          "tx":{"en":"Rest your mind fully"},
          "inf":{"en":"Helps emotional recovery"}
        },
        {
          "t":"breath_auto",
