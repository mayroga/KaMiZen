      "cat":"focus_under_pressure",
      "b":[
        {"t":"v","tx":{"en":"MISSION 38: ONE STEP ONLY"}},
        {"t":"h","tx":{"en":"Do one question at a time"}},
        {"story":{"en":"You don’t need to do everything at once. Just focus on one step."}},
        {
          "t":"breath_auto",
          "d":35,
          "tx":{"en":"One slow breath before starting"},
          "inf":{"en":"Helps your brain focus"}
        },
        {
          "t":"d",
          "q":{"en":"Best way to take an exam?"},
          "op":[
            "One by one",
            "All at once",
            "Random guessing",
            "Skip everything"
          ],
          "c":0,
          "ex":[
            "One by one = control",
            "All at once = confusion",
            "Guessing = mistakes",
            "Skipping = incomplete"
          ]
        },
        {
          "t":"d",
          "q":{"en":"What improves focus during pressure?"},
          "op":[
            "Thinking about everything",
            "Panicking",
            "Looking at others",
            "Staying with one step"
          ],
          "c":3,
          "ex":[
            "Too many thoughts create overload.",
            "Panic blocks concentration.",
            "Comparing yourself creates distraction.",
            "Correct. One step improves focus."
          ]
        },
        {"t":"r","tx":"+Focus","p":25},
        {
          "t":"sil",
          "d":45,
          "tx":{"en":"Stay only with this moment"},
          "inf":{"en":"Helps attention stay strong"}
        },
        {
          "t":"breath_auto",
          "d":25,
          "tx":{"en":"Inhale focus... exhale noise"},
          "inf":{"en":"Helps clear your mind"}
        }
      ]
    },
    {
