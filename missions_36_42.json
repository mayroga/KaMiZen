  "missions":[
    {
      "id":36,
      "cat":"exam_anxiety",
      "b":[
        {"t":"v","tx":{"en":"MISSION 36: CALM YOUR BODY BEFORE THE TEST"}},
        {"t":"h","tx":{"en":"Your body is safe. It is just getting ready."}},
        {"story":{"en":"If your heart beats fast or your stomach feels strange, it is only energy. Not danger. Your body is helping you focus."}},
        {
          "t":"breath_auto",
          "d":40,
          "tx":{"en":"Breathe in slowly... breathe out slowly"},
          "inf":{"en":"Tells your body it is safe now"}
        },
        {
          "t":"d",
          "q":{"en":"What does nervous feeling mean?"},
          "op":[
            "Danger",
            "Something is wrong",
            "I should escape",
            "My body is ready"
          ],
          "c":3,
          "ex":[
            "Thinking it is danger increases fear.",
            "Believing something is wrong can create panic.",
            "Escaping teaches the brain to fear the situation.",
            "Correct. Nervous feelings are your body preparing you."
          ]
        },
        {
          "t":"d",
          "q":{"en":"What helps calm your body before a test?"},
          "op":[
            "Fast panic thinking",
            "Running away",
            "Slow breathing",
            "Ignoring feelings"
          ],
          "c":2,
          "ex":[
            "Panic increases stress.",
            "Avoiding increases fear later.",
            "Correct. Slow breathing calms the nervous system.",
            "Ignoring feelings does not regulate them."
          ]
        },
        {"t":"r","tx":"+Body Calm","p":25},
        {
          "t":"sil",
          "d":35,
          "tx":{"en":"Feel your body without fear"},
          "inf":{"en":"Helps your mind stay calm"}
        },
        {
          "t":"breath_auto",
          "d":30,
          "tx":{"en":"Inhale calm... exhale worry"},
          "inf":{"en":"Helps control stress in the body"}
        }
      ]
    },
    {
      "id":37,
      "cat":"fear_management",
      "b":[
        {"t":"v","tx":{"en":"MISSION 37: FEAR IS JUST A FEELING"}},
        {"t":"h","tx":{"en":"Fear is not a command. It is just a signal."}},
        {"story":{"en":"Fear comes when something is important. But you can still act calmly."}},
        {
          "t":"breath_auto",
          "d":40,
          "tx":{"en":"Slow breathing helps you stay in control"},
          "inf":{"en":"Helps your brain stay calm and clear"}
        },
        {
          "t":"d",
          "q":{"en":"What should you do when you feel fear?"},
          "op":[
            "Stop everything",
            "Run away",
            "Scream",
            "Stay calm and continue"
          ],
          "c":3,
          "ex":[
            "Stopping breaks progress",
            "Running avoids learning",
            "Screaming increases stress",
            "Calm keeps control"
          ]
        },
        {
          "t":"d",
          "q":{"en":"What is fear really?"},
          "op":[
            "A danger command",
            "Proof you cannot do it",
            "A temporary feeling",
            "A reason to quit"
          ],
          "c":2,
          "ex":[
            "Fear is not always danger.",
            "Fear does not define ability.",
            "Correct. Fear is only a feeling.",
            "Quitting strengthens avoidance."
          ]
        },
        {"t":"r","tx":"+Fear Control","p":25},
        {
          "t":"sil",
          "d":40,
          "tx":{"en":"Let fear stay, but don’t follow it"},
          "inf":{"en":"Builds inner strength"}
        },
        {
          "t":"breath_auto",
          "d":30,
          "tx":{"en":"Inhale calm... exhale fear"},
          "inf":{"en":"Helps your body relax"}
        }
      ]
    },
    {
