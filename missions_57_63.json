  "missions":[
    {
      "id":57,
      "cat":"social_support",
      "b":[
        {"t":"v","tx":{"en":"MISSION 57: NEVER ALONE"}},
        {"t":"h","tx":{"en":"Use your imagination to feel strong"}},
        {"story":{"en":"If you ever feel lonely, use your imagination. Pretend your plushies or imaginary friends are talking and playing with you. Your mind can create comfort and connection whenever you need it."}},
        {"t":"breath_auto","d":30,
        "tx":{"en":"Breathe in friendship... breathe out lonely feelings"},
        "inf":{"en":"Fills your heart with comfort"}
        },
        {"t":"d","q":{"en":"What can you do if you feel lonely?"},
        "op":["Cry all day","Use your imagination and plushies","Wait forever","Get angry"],
        "c":1,
        "ex":[
          "Crying alone does not solve loneliness",
          "Imagination creates comfort and connection",
          "Waiting forever increases sadness",
          "Anger hurts your emotions"
        ]},
        {"t":"d","q":{"en":"What helps you feel emotionally stronger?"},
        "op":["Staying isolated","Creating positive thoughts","Ignoring feelings","Giving up"],
        "c":1,
        "ex":[
          "Isolation increases loneliness",
          "Positive imagination builds emotional support",
          "Ignoring feelings removes awareness",
          "Giving up weakens confidence"
        ]},
        {"t":"r","tx":"+Emotional Support","p":20},
        {"t":"sil","d":45,
        "tx":{"en":"Your mind can create comfort and peace"},
        "inf":{"en":"Builds emotional resilience"}
        },
        {"t":"breath_auto","d":30,
        "tx":{"en":"Inhale peace... exhale loneliness"},
        "inf":{"en":"Calms your emotions"}
        }
      ]
    },
    {
      "id":58,
      "cat":"social_integration",
      "b":[
        {"t":"v","tx":{"en":"MISSION 58: JOINING THE GAME"}},
        {"t":"h","tx":{"en":"You can slowly become part of the group"}},
        {"story":{"en":"To play with other kids, observe first and calmly join the activity. Social confidence grows through participation."}},
        {"t":"breath_auto","d":35,
        "tx":{"en":"Breathe slowly and feel confident"},
        "inf":{"en":"Helps you join others calmly"}
        },
        {"t":"d","q":{"en":"What is a simple way to join a game?"},
        "op":["Interrupt everyone","Join calmly where they are playing","Stay alone forever","Ask too many questions"],
        "c":1,
        "ex":[
          "Interrupting creates tension",
          "Joining calmly helps social connection",
          "Isolation blocks friendship",
          "Too many questions stop the flow"
        ]},
        {"t":"d","q":{"en":"What helps you understand a group activity?"},
        "op":["Ignoring everyone","Observing before acting","Running away","Controlling the game"],
        "c":1,
        "ex":[
          "Ignoring removes awareness",
          "Observation helps understanding",
          "Running away prevents participation",
          "Control creates conflict"
        ]},
        {"t":"r","tx":"+Social Skills","p":25},
        {"t":"sil","d":50,
        "tx":{"en":"Observe the game before joining"},
        "inf":{"en":"Helps you understand the group"}
        },
        {"t":"breath_auto","d":30,
        "tx":{"en":"Inhale courage... exhale shyness"},
        "inf":{"en":"Makes you ready to play"}
        }
      ]
    },
    {
      "id":59,
      "cat":"pain_management",
      "b":[
        {"t":"v","tx":{"en":"MISSION 59: THE HEADACHE STRATEGY"}},
        {"t":"h","tx":{"en":"Use other senses when one sense feels tired"}},
        {"story":{"en":"If your eyes hurt from light, you can still learn by listening carefully. Your brain can adapt using different senses."}},
        {"t":"breath_auto","d":40,
        "tx":{"en":"Soft breathing for your head"},
        "inf":{"en":"Reduces pressure and tension"}
        },
        {"t":"d","q":{"en":"How can you learn if your eyes hurt?"},
        "op":["Close your ears","Listen and memorize","Give up completely","Look harder"],
        "c":1,
        "ex":[
          "Closing your ears removes learning input",
          "Listening helps protect your eyes",
          "Giving up stops progress",
          "Looking harder increases discomfort"
        ]},
        {"t":"d","q":{"en":"What shows adaptability during discomfort?"},
        "op":["Panic immediately","Use another strategy","Quit the lesson","Ignore pain completely"],
        "c":1,
        "ex":[
          "Panic reduces thinking",
          "Adaptation keeps learning active",
          "Quitting stops growth",
          "Ignoring pain removes awareness"
        ]},
        {"t":"r","tx":"+Adaptability","p":20},
        {"t":"sil","d":60,
        "tx":{"en":"Rest your eyes and focus your hearing"},
        "inf":{"en":"Builds flexible learning skills"}
        },
        {"t":"breath_auto","d":30,
        "tx":{"en":"Inhale quiet... exhale pain"},
        "inf":{"en":"Helps your body relax"}
        }
      ]
    },
    {
