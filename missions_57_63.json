        "tx":{"en":"Breathe in focus... breathe out distraction"},
        "inf":{"en":"Prepares your brain for self-control"}
        },
        {"t":"d","q":{"en":"What keeps your brain sharp while using screens?"},
        "op":["Play endlessly","Short balanced sessions","Check notifications constantly","Ignore homework"],
        "c":1,
        "ex":[
          "Endless play weakens focus",
          "Balanced use protects attention",
          "Constant checking creates distraction",
          "Ignoring work creates problems"
        ]},
        {"t":"d","q":{"en":"What is a healthy use of technology?"},
        "op":["Using it without limits","Using it with control","Playing during homework","Never stopping"],
        "c":1,
        "ex":[
          "No limits create overload",
          "Control builds discipline",
          "Multitasking reduces learning",
          "Never stopping causes fatigue"
        ]},
        {"t":"r","tx":"+Self-Control","p":30},
        {"t":"sil","d":40,
        "tx":{"en":"Think calmly about your next task"},
        "inf":{"en":"Prepares your brain for responsibility"}
        },
        {"t":"breath_auto","d":30,
        "tx":{"en":"Inhale order... exhale distraction"},
        "inf":{"en":"Builds discipline"}
        }
      ]
    },
