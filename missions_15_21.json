          "t": "sil",
          "d": 40,
          "tx": {"en": "Watch the emotion without responding to it"},
          "inf": {"en": "Strengthens emotional separation between feeling and action"}
        },
        {
          "t": "breath_auto",
          "d": 25,
          "tx": {"en": "Inhale stability... exhale impulsiveness"},
          "inf": {"en": "This regulates nervous system reactivity and improves decision timing"}
        }
